# ============================================================
# Stellent QA — environment variables
# Copy to .env.local and fill in. Never commit real secrets.
# On Vercel, set these under Project → Settings → Environment Variables.
# ============================================================

# --- Supabase (public: safe to expose to the browser) -------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Supabase (server only: NEVER expose to the client) -----
# Used by the VPS callback to write results, bypassing RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Audit engine (VPS) webhook -----------------------------
# Shared secret sent as x-webhook-secret in BOTH directions.
WEBHOOK_SECRET=generate-a-long-random-string
# Intake endpoint the app POSTs audit jobs to.
VPS_AUDIT_URL=https://qa-intake.stellent.work/run-audit

# --- App ----------------------------------------------------
# Public base URL; used to build the VPS callback URL.
NEXT_PUBLIC_APP_URL=https://qa.stellent.ai

# --- Later build steps (not required for the current slice) --
# RESEND_API_KEY=            # email notifications
# SCHEDULER_SECRET=          # pg_cron -> scheduled-audit endpoint auth
